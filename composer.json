{
    "name": "postiefs/laravel-sso",
    "description": "Sign in to a Laravel app through the Postiefs SSO portal (Microsoft Entra ID), with portal-controlled sessions.",
    "keywords": ["laravel", "sso", "entra-id", "microsoft-365", "postiefs"],
    "type": "library",
    "homepage": "https://github.com/postiefs/laravel-sso",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10|^7.0",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/session": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Postiefs\\Sso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Postiefs\\Sso\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Postiefs\\Sso\\SsoServiceProvider"
            ],
            "aliases": {
                "Sso": "Postiefs\\Sso\\Facades\\Sso"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
